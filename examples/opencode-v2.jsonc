{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "opencode-rtl-fix",
      "options": {
        "language": "auto",
        "systemGuidance": true,
        "isolateUserMessages": "auto",
        "isolateAssistantText": "auto",
        "isolateToolOutput": "off",
        "inlineControls": false,
        "minRtlRatio": 0.2,
        "minRtlCharacters": 2,
        "digitMode": "preserve",
        "forceDirection": "auto",
        "alignRtlParagraphs": false,
        "rtlWrapColumn": 96,
        "rtlAlignColumn": 96
      }
    }
  ]
}
